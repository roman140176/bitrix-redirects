{
    "name": "roman140176/redirects",
    "description": "Модуль 1С-Битрикс: редиректы 301 и 302 и журнал 404",
    "type": "bitrix-d7-module",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "classmap": ["lib/"],
        "psr-4": {
            "Roman140176\\Redirects\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
